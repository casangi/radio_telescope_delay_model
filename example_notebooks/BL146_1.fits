                  BITPIX  =                    8 /                                                NAXIS   =                    2 /                                                NAXIS1  =                  100 /                                                NAXIS2  =                    1 /                                                PCOUNT  =                    0 /                                                GCOUNT  =                    1 /                                                TFIELDS =                    6 /                                                EXTNAME = 'FREQUENCY'          /                                                EXTVER  =                    1 /                                                TTYPE1  = 'FREQID  '           / FREQID number in uv data                       TFORM1  = '1J      '           /                                                TTYPE2  = 'BANDFREQ'           / frequency offset                               TFORM2  = '4D      '           /                                                TUNIT2  = 'HZ      '           /                                                TTYPE3  = 'CH_WIDTH'           / spectral channel bandwidth                     TFORM3  = '4E      '           /                                                TUNIT3  = 'HZ      '           /                                                TTYPE4  = 'TOTAL_BANDWIDTH'    / total bw of a BAND                             TFORM4  = '4E      '           /                                                TUNIT4  = 'HZ      '           /                                                TTYPE5  = 'SIDEBAND'           / sideband of each BAND                          TFORM5  = '4J      '           /                                                TTYPE6  = 'BB_CHAN '           / baseband channel number (1-16)                 TFORM6  = '4J      '           /                                                OBSCODE = 'BL146   '           /                              